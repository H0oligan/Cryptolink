{
  "name": "admin-frontend-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest run"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npx --no-install lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.ts?(x)": "make precommit-ts",
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix --quiet",
      "git add"
    ],
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --quiet",
      "git add"
    ],
    "*.{json,scss,css,md,html}": [
      "prettier --write",
      "git add"
    ]
  },
  "overrides": {
    "path-to-regexp": "^8.2.0",
    "picomatch": "^4.0.3",
    "@eslint/config-array": {
      "minimatch": "^11.0.5"
    },
    "eslint": {
      "minimatch": "^11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  },
