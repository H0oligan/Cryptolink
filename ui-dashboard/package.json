      "git add"
    ],
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --quiet",
      "git add"
    ],
    "*.{json,scss,css,md,html}": [
      "prettier --write",
      "git add"
    ]
  },
  "overrides": {
